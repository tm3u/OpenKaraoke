<Window x:Class="OpenKaraoke.Prototype.PerformanceDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenKaraoke.Prototype"
 Title="演唱回顧" Width="920" Height="540" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}" PreviewKeyDown="Window_KeyDown">
 <Window.Resources><Style TargetType="{x:Type local:Icon}"><Setter Property="StrokeThickness" Value="2"/></Style></Window.Resources>
 <Border x:Name="DialogSurface" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="0">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border x:Name="DialogHeader" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,15,14,15" MouseLeftButtonDown="Header_Drag">
    <DockPanel LastChildFill="True" Height="34">
     <Button x:Name="CloseDialogButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" Padding="7" ToolTip="關閉" AutomationProperties.Name="關閉演唱回顧" Click="Close_Click"><local:Icon Kind="x" Width="16" Height="16"/></Button>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:Icon Kind="audio-lines" Width="17" Height="17" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/><TextBlock Text="演唱回顧" FontSize="17" VerticalAlignment="Center"/></StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
     <StackPanel>
      <TextBlock x:Name="PerformanceTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="PerformanceArtist" FontSize="13" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <Border Background="{StaticResource Raised}" CornerRadius="8" Padding="16" Margin="0,24,0,0">
       <StackPanel>
        <TextBlock x:Name="PerformanceScoreLabel" Text="音準分數" FontSize="12" Foreground="{StaticResource Sub}"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="PerformanceScore" FontSize="44" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="/ 100" FontSize="13" Foreground="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="8,0,0,8"/></StackPanel>
        <TextBlock x:Name="ScoreStatus" Text="本次沒有可用分數" FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <TextBlock x:Name="IncompleteStatus" Text="本次未唱完" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,12,0,0"/>
     </StackPanel>
    </ScrollViewer>
    <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="20">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="True">
       <Button x:Name="RecordingDownloadButton" DockPanel.Dock="Right" IsEnabled="False" Padding="10,7" AutomationProperties.Name="下載演唱錄音" Click="Download_Click"><StackPanel Orientation="Horizontal"><local:Icon Kind="download" Width="14" Height="14" Margin="0,0,7,0"/><TextBlock x:Name="RecordingDownloadLabel" Text="下載錄音" FontSize="12"/></StackPanel></Button>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:Icon Kind="music" Width="16" Height="16" Foreground="{StaticResource Sub}" Margin="0,0,8,0"/><TextBlock Text="錄音播放" FontSize="14"/></StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,14,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
       <Button x:Name="RecordingPauseButton" Style="{StaticResource PrimaryButton}" Height="36" Padding="10,7" Margin="0,0,12,0" IsEnabled="False" Click="Toggle_Click"><StackPanel Orientation="Horizontal"><local:Icon x:Name="RecordingStateIcon" Kind="play" Width="14" Height="14" Margin="0,0,7,0"/><TextBlock x:Name="RecordingPauseLabel" Text="播放" FontSize="12"/></StackPanel></Button>
       <Slider x:Name="RecordingProgress" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5" VerticalAlignment="Center" AutomationProperties.Name="錄音與音準回顧進度" ValueChanged="Progress_Changed"/>
       <TextBlock x:Name="RecordingTime" Grid.Column="2" FontSize="12" Foreground="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="2" Margin="0,26,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="音準紀錄" FontSize="14"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="12" Height="4" Background="#8F99A7" CornerRadius="2" Margin="0,0,5,0"/><TextBlock Text="原始旋律" FontSize="11" Foreground="{StaticResource Sub}" Margin="0,0,12,0"/>
        <Border Width="12" Height="4" Background="#64DD8E" CornerRadius="2" Margin="0,0,5,0"/><TextBlock Text="音準正確" FontSize="11" Foreground="{StaticResource Sub}" Margin="0,0,12,0"/>
        <Border Width="12" Height="4" Background="#F07883" CornerRadius="2" Margin="0,0,5,0"/><TextBlock Text="音準偏差" FontSize="11" Foreground="{StaticResource Sub}"/>
       </StackPanel>
      </Grid>
      <Border x:Name="PitchSurface" Grid.Row="3" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8" ClipToBounds="True">
       <Grid><local:PitchGuide x:Name="PerformanceOverview" Overview="True" FollowPlayback="True" IsHitTestVisible="False"/><TextBlock x:Name="NoPitchStatus" Text="本次沒有音準紀錄" FontSize="13" Foreground="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Border>
      <TextBlock x:Name="RecordingStatus" Grid.Row="4" FontSize="12" Foreground="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <ScrollViewer x:Name="RecordingErrorViewport" Grid.Row="5" MaxHeight="60" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock x:Name="RecordingError" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/></ScrollViewer>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>
