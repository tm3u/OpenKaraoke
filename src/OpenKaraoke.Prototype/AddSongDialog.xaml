<Window x:Class="OpenKaraoke.Prototype.AddSongDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenKaraoke.Prototype"
 Title="加入歌曲" Width="720" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="{x:Type local:Icon}"><Setter Property="StrokeThickness" Value="2"/></Style>
  <Style x:Key="LyricsModeChoice" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="ChoiceSurface" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
     <Grid Width="16" Height="16" VerticalAlignment="Center"><Ellipse x:Name="ChoiceRing" Stroke="{StaticResource Sub}" StrokeThickness="1.5"/><Ellipse x:Name="ChoiceDot" Width="8" Height="8" Fill="{StaticResource Accent}" Visibility="Collapsed"/></Grid>
     <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
    </StackPanel></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter TargetName="ChoiceRing" Property="Stroke" Value="{StaticResource Accent}"/><Setter TargetName="ChoiceDot" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="{StaticResource Raised}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChoiceSurface" Property="Opacity" Value="0.48"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="DialogSurface" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="0"><Grid x:Name="DialogLayout">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="DialogHeader" Padding="22,15,14,15" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Heading_MouseDown"><Grid Height="34"><StackPanel Orientation="Horizontal"><local:Icon Kind="music" Width="17" Height="17" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/><TextBlock Text="加入歌曲" FontSize="17"/></StackPanel><Button x:Name="CloseDialogButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" AutomationProperties.Name="關閉加入歌曲" Click="Close_Click"><local:Icon Kind="x" Width="16" Height="16" Foreground="{StaticResource Sub}"/></Button></Grid></Border>
  <Grid x:Name="EntryArea" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width=".95*"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="FormFields" Margin="20" VerticalAlignment="Top">
    <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="4" Margin="0,0,0,22"><UniformGrid Rows="1">
     <Button x:Name="CreateTab" AutomationProperties.Name="製作歌曲" Click="CreateTab_Click" Padding="6,8"><StackPanel Orientation="Horizontal"><local:Icon Kind="sparkles" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="製作歌曲" FontSize="13"/></StackPanel></Button>
     <Button x:Name="ImportTab" AutomationProperties.Name="匯入歌曲" Click="ImportTab_Click" Padding="6,8"><StackPanel Orientation="Horizontal"><local:Icon Kind="package" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="匯入歌曲" FontSize="13"/></StackPanel></Button>
    </UniformGrid></Border>
    <Grid>
    <StackPanel x:Name="CreateSource" VerticalAlignment="Top">
     <TextBlock Text="YouTube 網址" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,0,0,7"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid><TextBox x:Name="UrlInput" AutomationProperties.Name="YouTube 網址" Background="{StaticResource Raised}" Height="42" TextChanged="Url_Changed"/><TextBlock x:Name="UrlHint" Text="貼上 YouTube 影片網址" FontSize="14" Foreground="{StaticResource Sub}" Margin="11,0" IsHitTestVisible="False"/></Grid>
      <Button x:Name="ReadVideoButton" Grid.Column="1" AutomationProperties.Name="讀取影片" Height="42" MinWidth="94" Margin="8,0,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="11,8" Click="ReadVideo_Click"><StackPanel Orientation="Horizontal"><local:Icon x:Name="ReadVideoIcon" Kind="search" Width="15" Height="15" Margin="0,0,7,0"/><TextBlock x:Name="ReadVideoLabel" Text="讀取影片" FontSize="12"/></StackPanel></Button>
     </Grid>
    </StackPanel>
    <StackPanel x:Name="ImportSource" VerticalAlignment="Top" Visibility="Collapsed">
     <TextBlock x:Name="PackageLabel" Text="選擇歌曲檔" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,0,0,7"/>
     <Button x:Name="ChoosePackageButton" AutomationProperties.Name="選擇 opok 歌曲檔" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="11,8" Height="42" HorizontalContentAlignment="Stretch" Click="ChoosePackage_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="PackageFilename" Text=".opok" FontSize="14" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis"/>
      <local:Icon Grid.Column="1" Kind="folder-open" Width="17" Height="17" Foreground="{StaticResource Sub}"/>
     </Grid></Button>
    </StackPanel>
    </Grid>
    <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="歌名" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,0,0,7"/><Grid><TextBox x:Name="TitleInput" Height="42" MaxLength="120" Background="{StaticResource Raised}" AutomationProperties.Name="歌名" TextChanged="Names_Changed" LostFocus="Name_LostFocus"/><TextBlock x:Name="TitleHint" Text="輸入歌名" Foreground="{StaticResource Sub}" Margin="11,0" IsHitTestVisible="False"/></Grid></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="歌手" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,0,0,7"/><Grid><TextBox x:Name="ArtistInput" Height="42" MaxLength="120" Background="{StaticResource Raised}" AutomationProperties.Name="歌手" TextChanged="Names_Changed" LostFocus="Name_LostFocus"/><TextBlock x:Name="ArtistHint" Text="輸入歌手" Foreground="{StaticResource Sub}" Margin="11,0" IsHitTestVisible="False"/></Grid></StackPanel>
    </Grid>
    <StackPanel x:Name="LyricsSection" Margin="0,18,0,0">
     <TextBlock Text="歌詞（選填）" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,0,0,7"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="ChooseLyricsButton" AutomationProperties.Name="選擇歌詞檔" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Height="42" Padding="11,8" HorizontalContentAlignment="Stretch" Click="ChooseLyrics_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock x:Name="LyricsFilename" Text="選擇 .lrc 或 .ass 歌詞檔" FontSize="13" Foreground="{StaticResource Sub}" TextTrimming="CharacterEllipsis"/><local:Icon Grid.Column="1" Kind="folder-open" Width="17" Height="17" Foreground="{StaticResource Sub}"/></Grid></Button>
      <Button x:Name="ClearLyricsButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="36" Margin="5,0,0,0" AutomationProperties.Name="移除尚未加入的歌詞" Visibility="Collapsed" Click="ClearLyrics_Click"><local:Icon Kind="x" Width="15" Height="15" Foreground="{StaticResource Sub}"/></Button>
     </Grid>
     <UniformGrid Rows="1" Margin="0,8,0,0">
      <RadioButton x:Name="ScrollLyricsButton" GroupName="LyricsDisplayMode" Tag="scroll" Content="滾動歌詞" AutomationProperties.Name="滾動歌詞模式" Style="{StaticResource LyricsModeChoice}" Margin="0,0,4,0" IsChecked="True" Checked="LyricsMode_Changed"/>
      <RadioButton x:Name="KaraokeLyricsButton" GroupName="LyricsDisplayMode" Tag="karaoke" Content="KTV 逐字" AutomationProperties.Name="KTV 逐字模式" Style="{StaticResource LyricsModeChoice}" Margin="4,0,0,0" Checked="LyricsMode_Changed"/>
     </UniformGrid>
     <TextBlock x:Name="LyricsError" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,5,0,0"/>
    </StackPanel>
    <ScrollViewer x:Name="FormErrorViewport" Style="{StaticResource ThinScrollViewer}" MaxHeight="72" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding Visibility,ElementName=FormError}"><TextBlock x:Name="FormError" FontSize="12" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Visibility="Collapsed"/></ScrollViewer>
    <Button x:Name="SubmitButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Height="38" Margin="0,22,0,0" Padding="11,8" AutomationProperties.Name="加入處理清單" Click="Submit_Click"><StackPanel Orientation="Horizontal"><local:Icon Kind="list-plus" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="加入處理清單"/></StackPanel></Button>
   </StackPanel>
   <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="20"><Grid Height="{Binding ActualHeight,ElementName=FormFields}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><local:Icon Kind="list-ordered" Width="16" Height="16" Foreground="{StaticResource Sub}" Margin="0,0,7,0"/><TextBlock Text="處理清單" FontSize="14"/></StackPanel>
    <ListBox x:Name="ProcessingList" Style="{StaticResource ProcessingListStyle}" Grid.Row="1" AutomationProperties.Name="處理清單"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <local:Icon Kind="{Binding Icon}" Foreground="{Binding IconBrush}" Width="17" Height="17" VerticalAlignment="Top" Margin="0,3,0,0"/>
     <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Artist}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Sub}" Margin="0,3,0,0" Visibility="{Binding ArtistVisible}"/></StackPanel>
     <Button Grid.Column="2" Width="28" Height="30" MinHeight="30" Padding="5" Tag="{Binding Id}" ToolTip="{Binding ActionTooltip}" AutomationProperties.Name="{Binding ActionName}" Visibility="{Binding ActionVisible}" Click="JobAction_Click"><local:Icon Kind="{Binding ActionIcon}" Width="15" Height="15" Foreground="{StaticResource Sub}"/></Button>
     <Grid Grid.Row="1" Grid.Column="1" Margin="9,8,0,0" Visibility="{Binding StageVisible}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Stage}" Foreground="{Binding StageBrush}" FontSize="12" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Percent}" Foreground="{Binding StageBrush}" FontSize="12" Margin="8,0,0,0"/></Grid>
     <ProgressBar Grid.Row="2" Grid.Column="1" Margin="9,8,0,0" Height="4" Style="{StaticResource SoftProgress}" Maximum="100" Value="{Binding Progress,Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Visibility="{Binding ProgressVisible}"/>
    </Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock x:Name="ProcessingEmpty" Grid.Row="1" Text="尚無處理工作" FontSize="12" Foreground="{StaticResource Sub}" HorizontalAlignment="Center"/>
   </Grid></Border>
  </Grid>
 </Grid></Border>
</Window>
